@Secretaria.api_HostAddress = http://localhost:5194
@AtendimentoApiKey = configure-aqui

POST {{Secretaria.api_HostAddress}}/api/atendimento
Accept: application/json
Content-Type: application/json
X-Atendimento-Api-Key: {{AtendimentoApiKey}}

{
  "nome": "Cesar",
  "email": "cesar@example.com",
  "telefone": "+5511999999999",
  "mensagem": "Gostaria de informações sobre matrícula."
}

