{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Authentication": {
    "AtendimentoApiKey": "",
    "AtendimentoApiKeys": [],
    "AllowAnonymousInDevelopment": true
  },
  "RateLimiting": {
    "Atendimento": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AtendimentoResilience": {
    "TimeoutSeconds": 30,
    "MaxRetries": 2,
    "RetryDelayMilliseconds": 300
  }
}
